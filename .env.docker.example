# ── باك اند لوحة تحكم وفير داخل Docker (المنفذ 5000) ─────────────────────────
# انسخ هذا الملف إلى .env.docker (cp .env.docker.example .env.docker) واملأ القيم. لا ترفعه إلى git.

# عناوين الواجهة المسموح لها (IP الخادم أو النطاق مع المنفذ 5001) — مفصولة بفواصل
CORS_ORIGIN=http://YOUR_VPS_IP:5001

# قاعدة بيانات المنصّة (نفس قاعدة وفير). MariaDB على نفس الجهاز ⇒ host.docker.internal
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=mizan
DB_USER=wafeer
DB_PASSWORD=

# سرّ الجلسات: 32 حرفاً فأكثر — ولّده بـ:  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# المالك الأول: يُنشأ عند أول إقلاع فقط إن لم يوجد مالك (بعدها يمكن إفراغ كلمة المرور من هنا)
OWNER_USERNAME=owner
OWNER_PASSWORD=

# خادم وفير (مسارات /platform) ومفتاحه — يجب أن يطابق PLATFORM_API_KEY في wafeer/.env
WAFEER_API_URL=http://host.docker.internal:3000/api/v1
PLATFORM_API_KEY=

LOG_LEVEL=info

# ── لوحة تحكم وفير — الباك اند ───────────────────────────────────────────────
# انسخه إلى .env واملأه. يعمل للتطوير المحلي وللنشر بـ Docker معاً:
# داخل Docker يفرض docker-compose.yml القيم PORT=5000 وDB_HOST=db وDB_PORT=3306 تلقائياً،
# ويستعمل DB_NAME/DB_USER/DB_PASSWORD/DB_ROOT_PASSWORD لإنشاء قاعدة البيانات عند أول تشغيل.
NODE_ENV=development
PORT=4000
# عناوين الواجهة (React) المسموح لها — مفصولة بفواصل: واجهة اللوحة على الخادم + التطوير المحلي
CORS_ORIGIN=http://163.245.221.210:5001,http://localhost:5173

# قاعدة بيانات المنصّة (جداول platform_* — وهي قاعدة وفير نفسها). محلياً: MariaDB على جهازك.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mizan
DB_USER=wafeer
DB_PASSWORD=
# Docker فقط: كلمة مرور root لحاوية MariaDB، والمنفذ الذي تُعرض عليه القاعدة على المضيف (127.0.0.1)
# ليتصل بها خادم وفير — غيّره (مثلاً 3307) إن كان 3306 مشغولاً على الخادم.
DB_ROOT_PASSWORD=
DB_PUBLISH_PORT=3306

# جلسات المالك — 32 حرفاً فأكثر (ولّده بـ: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# المالك الأول: يُنشأ عند أول إقلاع إن لم يوجد أي مالك (يمكن إفراغ كلمة المرور بعد ذلك)
OWNER_USERNAME=owner
OWNER_PASSWORD=

# واجهة وفير البرمجية (مسارات /platform/*) ومفتاحها — نفس PLATFORM_API_KEY في wafeer/.env
# داخل Docker: حاوية وفير على الشبكة المشتركة wafeer-net — للتطوير المحلي: http://127.0.0.1:3000/api/v1
WAFEER_API_URL=http://wafeer-backend:5002/api/v1
PLATFORM_API_KEY=
LOG_LEVEL=info

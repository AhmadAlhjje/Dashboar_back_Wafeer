# ── لوحة تحكم وفير — الباك اند ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# عناوين الواجهة (React) المسموح لها — مفصولة بفواصل
CORS_ORIGIN=http://localhost:5173

# قاعدة بيانات المنصّة (جداول platform_* — يمكن أن تكون قاعدة وفير نفسها)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mizan
DB_USER=root
DB_PASSWORD=

# جلسات المالك
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=12h
BCRYPT_ROUNDS=12

# المالك الأول: يُنشأ عند أول إقلاع إن لم يوجد أي مالك (يُحذف من هنا بعد ذلك)
OWNER_USERNAME=owner
OWNER_PASSWORD=

# واجهة وفير البرمجية (مسارات /platform/*) ومفتاحها — نفس PLATFORM_API_KEY في wafeer/.env
WAFEER_API_URL=http://127.0.0.1:3000/api/v1
PLATFORM_API_KEY=
LOG_LEVEL=info
